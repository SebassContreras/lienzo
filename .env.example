# ==============================================================================
# Lienzo - Configuración de Variables de Entorno (TTS / OpenRouter)
# ==============================================================================
# Copia este archivo a `.env` y sustituye los placeholders por tus valores reales.
# El archivo `.env` está ignorado en Git (.gitignore) por seguridad.

# ------------------------------------------------------------------------------
# 1. Clave de API de OpenRouter (ÚNICA para Node/CLI y Editor Web)
# ------------------------------------------------------------------------------
# Obtenla en https://openrouter.ai/keys
# Solo se lee en Node (CLI/MCP y servidor de `pnpm dev`). El Editor Web llama a
# OpenRouter a través del proxy del servidor (/api/tts/speech), que añade la clave:
# nunca llega al navegador ni al bundle de `pnpm build`.
OPENROUTER_API_KEY="sk-or-v1-tu-clave-aqui"

# ------------------------------------------------------------------------------
# 2. Endpoint / Proxy de Audio Speech (Opcional)
# ------------------------------------------------------------------------------
# URL base para síntesis de voz (por defecto: https://openrouter.ai/api/v1/audio/speech)
# Útil si utilizas un proxy inverso, gateway corporativo o endpoint compatible con OpenAI.
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1/audio/speech"

# ------------------------------------------------------------------------------
# 3. Modelo y Voz por Defecto (Opcional)
# ------------------------------------------------------------------------------
# Modelo por defecto para CLI/MCP y Editor:
# Opciones populares:
#   - openai/tts-1 (por defecto)
#   - openai/tts-1-hd
#   - elevenlabs/eleven_multilingual_v2
#   - o cualquier modelo compatible en OpenRouter
OPENROUTER_TTS_MODEL="openai/tts-1"

# Voz por defecto:
#   - Para OpenAI: alloy, echo, fable, onyx, nova, shimmer
#   - Para ElevenLabs: rachel, drew, clyde, paul, domi, dave, fin, sarah, etc.
OPENROUTER_TTS_VOICE="alloy"

# ------------------------------------------------------------------------------
# 4. TTS Local / Kokoro (Opcional — voz offline, sin coste ni internet)
# ------------------------------------------------------------------------------
# Proveedor de voz activo: openrouter (nube) | local | kokoro | custom.
#   - openrouter: usa la API de OpenRouter (requiere OPENROUTER_API_KEY).
#   - local / kokoro / custom: usa un servidor TTS local compatible con
#     OpenAI /v1/audio/speech (por defecto Kokoro en http://localhost:8880).
TTS_PROVIDER="local"

# Endpoint del servidor local de voz (se acepta TTS_LOCAL_URL o KOKORO_TTS_URL).
# Arranca el servidor Kokoro con:  python server.py   (repositorio "kokoro")
TTS_LOCAL_URL="http://localhost:8880/v1/audio/speech"

# Voz y modelo por defecto para el proveedor local (por defecto ef_dora / kokoro-es).
#   - Español: ef_dora (femenina), em_alex (masculina), em_santa (masculina)
#   - Inglés US: af_heart, af_bella, am_adam, am_onyx, ...
#   - Inglés UK: bf_emma, bm_george, ...
KOKORO_TTS_VOICE="ef_dora"
KOKORO_TTS_MODEL="kokoro-es"
