# ==============================================================================
# Lienzo - Environment variables (TTS / OpenRouter)
# ==============================================================================
# Copy this file to `.env` and replace the placeholders with your real values.
# `.env` is ignored by Git (.gitignore).

# ------------------------------------------------------------------------------
# 1. OpenRouter API key (one key for Node/CLI and the web editor)
# ------------------------------------------------------------------------------
# Get it at https://openrouter.ai/keys
# Read in Node only (CLI/MCP and the `pnpm dev` server). The web editor calls
# OpenRouter through the server proxy (/api/tts/speech), which adds the key:
# it never reaches the browser or the `pnpm build` bundle.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# ------------------------------------------------------------------------------
# 2. Speech endpoint / proxy (optional)
# ------------------------------------------------------------------------------
# Base URL for speech synthesis (default: https://openrouter.ai/api/v1/audio/speech)
# Useful behind a reverse proxy, a corporate gateway or any OpenAI-compatible endpoint.
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1/audio/speech"

# ------------------------------------------------------------------------------
# 3. Default model and voice (optional)
# ------------------------------------------------------------------------------
# Default model for the CLI/MCP and the editor. Common choices:
#   - openai/tts-1 (default)
#   - openai/tts-1-hd
#   - elevenlabs/eleven_multilingual_v2
#   - or any compatible model on OpenRouter
OPENROUTER_TTS_MODEL="openai/tts-1"

# Default voice:
#   - OpenAI: alloy, echo, fable, onyx, nova, shimmer
#   - ElevenLabs: rachel, drew, clyde, paul, domi, dave, fin, sarah, etc.
OPENROUTER_TTS_VOICE="alloy"

# ------------------------------------------------------------------------------
# 4. Local TTS / Kokoro (optional — offline voice, free, no internet)
# ------------------------------------------------------------------------------
# Active speech provider: openrouter (cloud) | local | kokoro | custom.
#   - openrouter: uses the OpenRouter API (needs OPENROUTER_API_KEY).
#   - local / kokoro / custom: uses a local TTS server compatible with
#     OpenAI /v1/audio/speech (Kokoro at http://localhost:8880 by default).
TTS_PROVIDER="local"

# Local speech server endpoint (TTS_LOCAL_URL or KOKORO_TTS_URL is accepted).
# Start the Kokoro server with:  python server.py   ("kokoro" repository)
TTS_LOCAL_URL="http://localhost:8880/v1/audio/speech"

# Default voice and model for the local provider (default ef_dora / kokoro-es).
#   - Spanish: ef_dora (female), em_alex (male), em_santa (male)
#   - US English: af_heart, af_bella, am_adam, am_onyx, ...
#   - UK English: bf_emma, bm_george, ...
KOKORO_TTS_VOICE="ef_dora"
KOKORO_TTS_MODEL="kokoro-es"
