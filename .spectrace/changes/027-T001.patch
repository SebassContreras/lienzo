+import { describe, expect, it } from "vitest";
+import { parseSrt, parseSrtTimestamp, srtParser } from "./srt.ts";
+
+describe("parseSrtTimestamp", () => {
+  it("parses HH:MM:SS,mmm with comma", () => {
+    expect(parseSrtTimestamp("00:01:23,456")).toBeCloseTo(83.456);
+  });
+
+  it("parses HH:MM:SS.mmm with dot", () => {
+    expect(parseSrtTimestamp("01:00:00.500")).toBeCloseTo(3600.5);
+  });
+
+  it("parses MM:SS.mmm", () => {
+    expect(parseSrtTimestamp("02:15.200")).toBeCloseTo(135.2);
+  });
+});
+
+describe("parseSrt", () => {
+  it("parses standard multi-cue SRT string", () => {
+    const srt = `1
+00:00:01,000 --> 00:00:04,000
+Hola mundo!
+
+2
+00:00:04,500 --> 00:00:07,000
+Bienvenidos a Lienzo.
+Segunda línea.`;
+
+    const cues = parseSrt(srt);
+    expect(cues).toHaveLength(2);
+    expect(cues[0]).toEqual({
+      id: "1",
+      start: 1,
+      end: 4,
+      text: "Hola mundo!",
+    });
+    expect(cues[1]).toEqual({
+      id: "2",
+      start: 4.5,
+      end: 7,
+      text: "Bienvenidos a Lienzo. Segunda línea.",
+    });
+  });
+
+  it("handles UTF-8 BOM and Windows CRLF line breaks", () => {
+    const srt =
+      "\uFEFF1\r\n00:00:00,100 --> 00:00:02,000\r\nCon BOM y CRLF\r\n";
+    const cues = parseSrt(srt);
+    expect(cues).toHaveLength(1);
+    expect(cues[0].text).toBe("Con BOM y CRLF");
+    expect(cues[0].start).toBeCloseTo(0.1);
+    expect(cues[0].end).toBeCloseTo(2.0);
+  });
+
+  it("works through SubtitleParser interface", () => {
+    const srt = "00:00:00,000 --> 00:00:01,000\nPrueba sin número";
+    const cues = srtParser.parse(srt);
+    expect(cues).toHaveLength(1);
+    expect(cues[0].text).toBe("Prueba sin número");
+  });
+});
diff --git a/src/engine/subtitles/parsers/srt.ts b/src/engine/subtitles/parsers/srt.ts
new file mode 100644
index 0000000..70cd8a1
--- /dev/null
+++ b/src/engine/subtitles/parsers/srt.ts
@@ -0,0 +1,77 @@
+import type { SubtitleCue, SubtitleParser } from "../types.ts";
+
+/**
+ * Parses an SRT timestamp format: HH:MM:SS,mmm or HH:MM:SS.mmm into fractional seconds.
+ */
+export function parseSrtTimestamp(timestamp: string): number {
+  const clean = timestamp.trim().replace(",", ".");
+  const parts = clean.split(":");
+  if (parts.length === 3) {
+    const hours = Number.parseFloat(parts[0]) || 0;
+    const minutes = Number.parseFloat(parts[1]) || 0;
+    const seconds = Number.parseFloat(parts[2]) || 0;
+    return hours * 3600 + minutes * 60 + seconds;
+  }
+  if (parts.length === 2) {
+    const minutes = Number.parseFloat(parts[0]) || 0;
+    const seconds = Number.parseFloat(parts[1]) || 0;
+    return minutes * 60 + seconds;
+  }
+  return Number.parseFloat(clean) || 0;
+}
+
+/**
+ * Pure SRT (SubRip) subtitle format parser.
+ * Handles standard line breaks, BOM markers, multi-line cue texts, and comma/dot milliseconds.
+ */
+export function parseSrt(content: string): SubtitleCue[] {
+  // Strip UTF-8 BOM if present
+  const normalized = content
+    .replace(/^\uFEFF/, "")
+    .replace(/\r\n/g, "\n")
+    .replace(/\r/g, "\n");
+  const blocks = normalized.split(/\n\s*\n/);
+  const cues: SubtitleCue[] = [];
+
+  for (const block of blocks) {
+    const lines = block
+      .split("\n")
+      .map((l) => l.trim())
+      .filter((l) => l.length > 0);
+    if (lines.length === 0) continue;
+
+    // Check if first line is numeric index or timestamp
+    let timeLineIndex = 0;
+    if (/^\d+$/.test(lines[0]) && lines.length > 1) {
+      timeLineIndex = 1;
+    }
+
+    const timeLine = lines[timeLineIndex];
+    if (!timeLine?.includes("-->")) {
+      continue;
+    }
+
+    const [startRaw, endRaw] = timeLine.split("-->").map((s) => s.trim());
+    const start = parseSrtTimestamp(startRaw);
+    const end = parseSrtTimestamp(endRaw);
+
+    const textLines = lines.slice(timeLineIndex + 1);
+    const text = textLines.join(" ");
+
+    if (text.length > 0 && !Number.isNaN(start) && !Number.isNaN(end)) {
+      cues.push({
+        id:
+          lines[0] && timeLineIndex === 1 ? lines[0] : `cue-${cues.length + 1}`,
+        start,
+        end,
+        text,
+      });
+    }
+  }
+
+  return cues;
+}
+
+export const srtParser: SubtitleParser = {
+  parse: parseSrt,
+};
