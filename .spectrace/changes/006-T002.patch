diff --git a/src/traits/solid.ts b/src/traits/solid.ts
new file mode 100644
index 0000000..b6e3258
--- /dev/null
+++ b/src/traits/solid.ts
@@ -0,0 +1,16 @@
+import { defineTrait } from "./trait.ts";
+
+/** A one-color background with nothing on top; later traits can add dots or a light. */
+export const solid = defineTrait({
+  id: "solid",
+  label: "Color liso",
+  params: { color: "#0a1430" },
+  apply: {
+    background: (bg, p) => {
+      bg.color = p.color;
+      bg.gradient = false;
+      bg.dots = false;
+      bg.spotlight = 0;
+    },
+  },
+});
diff --git a/src/traits/spotlight.ts b/src/traits/spotlight.ts
