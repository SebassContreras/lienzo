+# ------------------------------------------------------------------------------
+# 4. TTS Local / Kokoro (Opcional — voz offline, sin coste ni internet)
+# ------------------------------------------------------------------------------
+# Proveedor de voz activo: openrouter (nube) | local | kokoro | custom.
+#   - openrouter: usa la API de OpenRouter (requiere OPENROUTER_API_KEY).
+#   - local / kokoro / custom: usa un servidor TTS local compatible con
+#     OpenAI /v1/audio/speech (por defecto Kokoro en http://localhost:8880).
+TTS_PROVIDER="local"
+
+# Endpoint del servidor local de voz (se acepta TTS_LOCAL_URL o KOKORO_TTS_URL).
+# Arranca el servidor Kokoro con:  python server.py   (repositorio "kokoro")
+TTS_LOCAL_URL="http://localhost:8880/v1/audio/speech"
+
+# Voz y modelo por defecto para el proveedor local (voces en español).
+#   - Español: ef_dora (femenina), em_alex (masculina), em_santa (masculina)
+#   - Inglés US: af_heart, af_bella, am_adam, am_onyx, ...
+#   - Inglés UK: bf_emma, bm_george, ...
+KOKORO_TTS_VOICE="ef_dora"
+KOKORO_TTS_MODEL="kokoro-es"
