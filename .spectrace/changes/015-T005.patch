+
+/* keyframe tracks under the scrub bar (015) */
+.tracks-panel {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 6px 12px 8px;
+  max-height: 180px;
+  overflow-y: auto;
+  background: var(--panel);
+  outline: none;
+}
+.track-row {
+  display: grid;
+  grid-template-columns: 110px 1fr;
+  align-items: center;
+  gap: 10px;
+  height: 22px;
+}
+.track-label {
+  color: var(--muted);
+  font-size: 12px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.track-lane {
+  position: relative;
+  height: 100%;
+  margin: 0 7px;
+  border-bottom: 1px solid var(--line);
+}
+.track-playhead {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  width: 1px;
+  background: var(--accent);
+  opacity: 0.6;
+  pointer-events: none;
+}
+.tracks-panel .keyframe {
+  position: absolute;
+  top: 50%;
+  width: 11px;
+  height: 11px;
+  padding: 0;
+  border: 1px solid var(--muted);
+  border-radius: 2px;
+  background: var(--panel);
+  transform: translate(-50%, -50%) rotate(45deg);
+  cursor: ew-resize;
+}
+.tracks-panel .keyframe.picked {
+  border-color: var(--accent);
+  background: var(--accent);
+}
+.track-easing {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-top: 4px;
+  font-size: 12px;
+  color: var(--muted);
+}
