diff --git a/src/service/tools/animation-list.ts b/src/service/tools/animation-list.ts
new file mode 100644
index 0000000..e951cfe
--- /dev/null
+++ b/src/service/tools/animation-list.ts
@@ -0,0 +1,29 @@
+import { z } from "zod";
+import { parseAnimPreset } from "../../model/anim-preset.ts";
+import { defineTool } from "../registry.ts";
+
+export const animationList = defineTool({
+  name: "animation_list",
+  description:
+    "List the animation presets (the editor's animation library) with their file name, name " +
+    "and category; files that fail the schema are left out. Use a name as an element's " +
+    "`animPreset`.",
+  input: z.object({}),
+  output: z.object({
+    animations: z.array(
+      z.object({
+        file: z.string(),
+        name: z.string(),
+        category: z.string().optional(),
+      }),
+    ),
+  }),
+  run: async (_input, ctx) => ({
+    animations: (await ctx.store.animPresets()).flatMap((item) => {
+      const parsed = parseAnimPreset(item.data);
+      if (!parsed.ok) return [];
+      const { name, category } = parsed.value;
+      return [{ file: item.name, name, ...(category ? { category } : {}) }];
+    }),
+  }),
+});
diff --git a/src/service/tools/animation-save.ts b/src/service/tools/animation-save.ts
new file mode 100644
index 0000000..9123cad
--- /dev/null
+++ b/src/service/tools/animation-save.ts
@@ -0,0 +1,29 @@
+import { join } from "node:path";
+import { z } from "zod";
+import { parseAnimPreset } from "../../model/anim-preset.ts";
+import { readJson, writeJson } from "../../presets/json-fs.ts";
+import { slugify } from "../../presets/slug.ts";
+import { defineTool, fail } from "../registry.ts";
+
+export const animationSave = defineTool({
+  name: "animation_save",
+  description:
+    "Save an animation preset ({ name, category?, anim?, tracks? }, checked as the editor's " +
+    "import checks it) into presets/animations/, as the animation library does. The file is " +
+    "named after `file`, else the preset's name; fails when it exists unless `overwrite` is true.",
+  input: z.object({
+    preset: z.unknown(),
+    file: z.string().min(1).optional(),
+    overwrite: z.boolean().optional(),
+  }),
+  output: z.object({ animation: z.string() }),
+  async run({ preset, file, overwrite }, ctx) {
+    const parsed = parseAnimPreset(preset);
+    if (!parsed.ok) fail("invalid_animation", parsed.error, parsed.path);
+    const dir = join(ctx.root, "presets", "animations");
+    const name = file ?? parsed.value.name;
+    if (!overwrite && (await readJson(dir, name)) !== undefined)
+      fail("exists", `Ya existe la animación «${slugify(name)}»`, "file");
+    return { animation: await writeJson(dir, name, parsed.value) };
+  },
+});
