index 0000000..5d29e30
--- /dev/null
+++ b/src/cli/help.ts
@@ -0,0 +1,49 @@
+/** Help text generated from the registry (008/D2): the tool list, and each tool's fields. */
+import type { Registry, Tool } from "../service/registry.ts";
+import { type Field, fieldsOf } from "./args.ts";
+
+const JSON_ARG = "[--json '<object>' | --json -]";
+
+/** Every tool with the first sentence of its description. */
+export function registryHelp(registry: Registry): string {
+  const width = Math.max(...registry.tools.map((t) => t.name.length));
+  return [
+    `Usage: pnpm lienzo <tool> [--<field> <value> ...] ${JSON_ARG}`,
+    "",
+    "Tools:",
+    ...registry.tools.map(
+      (t) =>
+        `  ${t.name.padEnd(width)}  ${t.description.split(/(?<=\.)\s+(?=[A-Z])/)[0]}`,
+    ),
+    "",
+    "Run `pnpm lienzo <tool> --help` for a tool's fields.",
+  ].join("\n");
+}
+
+function fieldLine(f: Field, prefix: string): string {
+  const type = f.types.length ? f.types.join(" | ") : "any";
+  const notes = [f.required ? "required" : "", f.description ?? ""]
+    .filter(Boolean)
+    .join(", ");
+  return `  ${prefix}${f.name} <${type}>${notes ? `  ${notes}` : ""}`;
+}
+
+/** One tool: its description and every field; fields that are not scalars go in `--json`. */
+export function toolHelp(tool: Tool): string {
+  const fields = fieldsOf(tool);
+  const flags = fields.filter((f) => f.flag);
+  const nested = fields.filter((f) => !f.flag);
+  return [
+    `Usage: pnpm lienzo ${tool.name} [flags] ${JSON_ARG}`,
+    "",
+    tool.description,
+    "",
+    "Flags:",
+    ...(flags.length ? flags.map((f) => fieldLine(f, "--")) : ["  (none)"]),
+    ...(nested.length
+      ? ["", "Only in --json:", ...nested.map((f) => fieldLine(f, ""))]
+      : []),
+    "",
+    "Flags override the same field in --json. The result is JSON on stdout.",
+  ].join("\n");
+}
diff --git a/src/cli/main.ts b/src/cli/main.ts
new file mode 100644
index 0000000..fc28902
--- /dev/null
+++ b/src/cli/main.ts
@@ -0,0 +1,78 @@
+/**
+ * `pnpm lienzo` (008): a thin adapter over the tool registry (A20) that holds no tool logic.
+ * The result is JSON on stdout; an error is JSON `{ code, message, path }` on stderr with
+ * exit code 1.
+ */
+import { join } from "node:path";
+import { text } from "node:stream/consumers";
+import { type Ctx, createCtx } from "../service/ctx.ts";
+import type { Registry } from "../service/registry.ts";
+import { registry } from "../service/tools/index.ts";
+import { inputOf, UsageError } from "./args.ts";
+import { registryHelp, toolHelp } from "./help.ts";
+
+/** What `run` writes to and reads from; tests pass their own. */
+export type Io = {
+  stdout(text: string): void;
+  stderr(text: string): void;
+  stdin(): Promise<string>;
+};
+
+const errorJson = (code: string, message: string) =>
+  JSON.stringify({ code, message, path: "" });
+
+/** Runs one command line (the arguments after the script) and returns the exit code. */
+export async function run(
+  argv: string[],
+  io: Io,
+  ctx: Ctx,
+  tools: Registry = registry,
+): Promise<number> {
+  const [name, ...args] = argv;
+  if (name === undefined || name === "--help" || name === "-h") {
+    io.stdout(registryHelp(tools));
+    return name === undefined ? 1 : 0;
+  }
+  const tool = tools.get(name);
+  if (!tool) {
+    io.stderr(errorJson("unknown_tool", `Unknown tool «${name}»; see --help`));
+    return 1;
+  }
+  let input: Record<string, unknown>;
+  try {
+    const parsed = await inputOf(tool, args, io.stdin);
+    if (parsed.help) {
+      io.stdout(toolHelp(tool));
+      return 0;
+    }
+    input = parsed.input;
+  } catch (error) {
+    if (!(error instanceof UsageError)) throw error;
+    io.stderr(errorJson("usage", error.message));
+    return 1;
+  }
+  const result = await tools.call(name, input, ctx);
+  if (!result.ok) {
+    io.stderr(JSON.stringify(result.error));
+    return 1;
+  }
+  io.stdout(JSON.stringify(result.value, null, 2));
+  return 0;
+}
+
+if (import.meta.main) {
+  const root = join(import.meta.dirname, "..", "..");
+  const io: Io = {
+    stdout: (t) => process.stdout.write(`${t}\n`),
+    stderr: (t) => process.stderr.write(`${t}\n`),
+    stdin: () => text(process.stdin),
+  };
+  process.exitCode = await run(
+    process.argv.slice(2),
+    io,
+    createCtx(root),
+  ).catch((error: unknown) => {
+    io.stderr(errorJson("internal", String(error)));
+    return 1;
+  });
+}
