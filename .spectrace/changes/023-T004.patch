+import { describe, expect, it } from "vitest";
+import { relativeLuminance } from "../engine/color.ts";
+import { defaultImage, defaultRect, defaultScene } from "../model/model.ts";
+import { resolveBackdropUnder } from "./contrast.ts";
+import type { PlacedElement } from "./layout.ts";
+
+describe("pure contrast backdrop resolution (023/D4, R5, R7, R8)", () => {
+  it("resolves solid scene background when no elements are below", () => {
+    const scene = defaultScene();
+    scene.background = {
+      ...scene.background,
+      color: "#ffffff",
+      gradient: false,
+    };
+    const textBox = { x: 100, y: 100, w: 200, h: 50 };
+    const fgLum = relativeLuminance(0, 0, 0); // black text
+
+    const res = resolveBackdropUnder(textBox, 0, [], scene, fgLum);
+    expect(res.kind).toBe("color");
+    if (res.kind === "color") {
+      expect(res.hex).toBe("#ffffff");
+    }
+  });
+
+  it("composites card fill over background", () => {
+    const scene = defaultScene();
+    scene.background = {
+      ...scene.background,
+      color: "#ffffff",
+      gradient: false,
+    };
+    const card = {
+      ...defaultRect(),
+      id: "card",
+      x: 50,
+      y: 50,
+      w: 400,
+      h: 200,
+      fill: {
+        color: "#000000",
+        color2: "#000000",
+        gradient: false,
+        angle: 0,
+        opacity: 1,
+      },
+    };
+    const placedBelow: PlacedElement[] = [
+      { el: card, box: { x: 50, y: 50, w: 400, h: 200 } },
+    ];
+    const textBox = { x: 100, y: 100, w: 100, h: 30 };
+    const fgLum = relativeLuminance(255, 255, 255); // white text
+
+    const res = resolveBackdropUnder(textBox, 1, placedBelow, scene, fgLum);
+    expect(res.kind).toBe("color");
+    if (res.kind === "color") {
+      expect(res.hex).toBe("#000000");
+    }
+  });
+
+  it("returns unverifiable when an image is below the text", () => {
+    const scene = defaultScene();
+    const img = {
+      ...defaultImage(),
+      id: "hero-img",
+      x: 0,
+      y: 0,
+      w: 500,
+      h: 500,
+    };
+    const placedBelow: PlacedElement[] = [
+      { el: img, box: { x: 0, y: 0, w: 500, h: 500 } },
+    ];
+    const textBox = { x: 50, y: 50, w: 200, h: 50 };
+
+    const res = resolveBackdropUnder(textBox, 1, placedBelow, scene, 1);
+    expect(res.kind).toBe("unverifiable");
+  });
+
+  it("picks the worst stop of a gradient background", () => {
+    const scene = defaultScene();
+    // Gradient from black (#000000) to white (#ffffff)
+    scene.background = {
+      ...scene.background,
+      color: "#000000",
+      color2: "#ffffff",
+      gradient: true,
+    };
+    const textBox = { x: 100, y: 100, w: 200, h: 50 };
+    const whiteTextLum = relativeLuminance(255, 255, 255);
+
+    // Against white text, the white stop (#ffffff) has lower contrast ratio (1:1) than black (21:1)
+    const res = resolveBackdropUnder(textBox, 0, [], scene, whiteTextLum);
+    expect(res.kind).toBe("color");
+    if (res.kind === "color") {
+      expect(res.hex).toBe("#ffffff");
+    }
+  });
+});
