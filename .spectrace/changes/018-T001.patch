new file mode 100644
index 0000000..163d563
--- /dev/null
+++ b/src/animations/index.ts
@@ -0,0 +1,17 @@
+/**
+ * The animation registry (018/D6): every kind a slot can play, one file per family. Entry and
+ * exit slots play `MOTIONS`; the loop slot plays `LOOPS`.
+ */
+import { ATTENTION } from "./attention.ts";
+import { MOTIONS } from "./motion.ts";
+
+export * from "./kind.ts";
+export { MOTIONS };
+
+export const LOOPS = { ...ATTENTION };
+
+export type MotionId = keyof typeof MOTIONS;
+export type LoopId = keyof typeof LOOPS;
+
+export const MOTION_IDS = Object.keys(MOTIONS) as MotionId[];
+export const LOOP_IDS = Object.keys(LOOPS) as LoopId[];
diff --git a/src/animations/kind.ts b/src/animations/kind.ts
new file mode 100644
index 0000000..f818441
--- /dev/null
+++ b/src/animations/kind.ts
@@ -0,0 +1,31 @@
+import type { EasingFn } from "../engine/easing.ts";
+
+export const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
+
+/** How an element looks at one moment: what its animations change, composed. */
+export type AnimState = {
+  dx: number;
+  dy: number;
+  scale: number;
+  alpha: number;
+  glowMul: number;
+  /** 0–1, how much of a line is drawn ("draw"); 1 for every other kind. */
+  progress: number;
+};
+
+/** What one kind changes; anything left out stays as it is. */
+export type Delta = Partial<AnimState>;
+
+/**
+ * A kind: what it changes at linear progress `p` (0 → 1, already turned around by the
+ * direction), given its easing and amount. Pure, so any slot can play it (013/D6).
+ */
+export type KindFn = (p: number, ease: EasingFn, amount: number) => Delta;
+
+export type KindDef = {
+  /** Its name in the inspector. */
+  label: string;
+  /** The curve it uses when its easing is `auto`. */
+  ease: EasingFn;
+  fn: KindFn;
+};
diff --git a/src/animations/motion.ts b/src/animations/motion.ts
new file mode 100644
