--- /dev/null
+++ b/src/animations/motion.ts
@@ -0,0 +1,29 @@
+/**
+ * Entrances: at progress 1 they leave the element as it is, at 0 it is hidden. An exit plays
+ * the same kind from 1 to 0 (013/D6), so exits have no code of their own.
+ */
+import { EASINGS } from "../engine/easing.ts";
+import { clamp01, type KindDef } from "./kind.ts";
+
+export const MOTIONS = {
+  fade: {
+    label: "Desvanecer",
+    ease: EASINGS["cubic-out"],
+    fn: (p, e) => ({ alpha: e(p) }),
+  },
+  pop: {
+    label: "Pop",
+    ease: EASINGS["back-out"],
+    fn: (p, e) => ({ alpha: clamp01(p * 2), scale: Math.max(0, e(p)) }),
+  },
+  slide: {
+    label: "Deslizar",
+    ease: EASINGS["cubic-out"],
+    fn: (p, e, amount) => ({ alpha: e(p), dy: (1 - e(p)) * amount }),
+  },
+  draw: {
+    label: "Dibujarse",
+    ease: EASINGS["cubic-out"],
+    fn: (p, e) => ({ progress: e(p) }),
+  },
+} satisfies Record<string, KindDef>;
