+/** Attention kinds, played in the loop slot: at 0 and 1 they leave the element as it is (A6). */
+import { EASINGS } from "../engine/easing.ts";
+import type { KindDef } from "./kind.ts";
+
+const TAU = Math.PI * 2;
+
+export const ATTENTION = {
+  float: {
+    label: "Flotar",
+    ease: EASINGS.linear,
+    fn: (p, e, amount) => ({ dy: -Math.sin(e(p) * TAU) * amount }),
+  },
+  pulse: {
+    label: "Pulso (escala)",
+    ease: EASINGS.linear,
+    fn: (p, e, amount) => ({
+      scale: 1 + (amount / 100) * (0.5 - 0.5 * Math.cos(e(p) * TAU)),
+    }),
+  },
+  breathe: {
+    label: "Brillo que respira",
+    ease: EASINGS.linear,
+    fn: (p, e, amount) => ({
+      glowMul: Math.max(0, 1 + (amount / 100) * Math.sin(e(p) * TAU)),
+    }),
+  },
+} satisfies Record<string, KindDef>;
