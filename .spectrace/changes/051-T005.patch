diff --git a/src/service/element-tree.test.ts b/src/service/element-tree.test.ts
new file mode 100644
index 0000000..f0f29c0
--- /dev/null
+++ b/src/service/element-tree.test.ts
@@ -0,0 +1,138 @@
+import { describe, expect, it } from "vitest";
+import { defaultElement, type Element, type GroupEl } from "../model/model.ts";
+import {
+  findElement,
+  insertChild,
+  updateElement,
+  updateSiblings,
+} from "./element-tree.ts";
+import { ToolFailure } from "./registry.ts";
+
+function makeGroup(id: string, children: Element[]): GroupEl {
+  return {
+    ...(defaultElement("group") as GroupEl),
+    id,
+    children,
+  };
+}
+
+function makeRect(id: string, x = 0): Element {
+  return {
+    ...defaultElement("rect"),
+    id,
+    x,
+  };
+}
+
+function expectFailure(fn: () => unknown): {
+  code: string;
+  message: string;
+  path: string;
+} {
+  try {
+    fn();
+  } catch (err) {
+    if (err instanceof ToolFailure) return err.error;
+    throw err;
+  }
+  throw new Error("Expected ToolFailure to be thrown");
+}
+
+describe("element-tree (051/D1, R1, R2)", () => {
+  it("finds a deeply nested element by unique id and by slash-separated path", () => {
+    const car = makeRect("s1-car", 42);
+    const innerGroup = makeGroup("layer-a", [car]);
+    const shot1 = makeGroup("shot-1", [innerGroup]);
+    const rootRect = makeRect("bg");
+    const tree: Element[] = [rootRect, shot1];
+
+    expect(findElement(tree, "s1-car")).toBe(car);
+    expect(findElement(tree, "shot-1/layer-a/s1-car")).toBe(car);
+    expect(findElement(tree, "bg")).toBe(rootRect);
+  });
+
+  it("disambiguates duplicate nested ids when addressed via slash path and rejects bare ambiguous id", () => {
+    const car1 = makeRect("car", 10);
+    const car2 = makeRect("car", 20);
+    const tree: Element[] = [
+      makeGroup("shot-1", [car1]),
+      makeGroup("shot-2", [car2]),
+    ];
+
+    expect(expectFailure(() => findElement(tree, "car"))).toMatchObject({
+      code: "ambiguous_id",
+      path: "id",
+    });
+    expect(findElement(tree, "shot-1/car")).toBe(car1);
+    expect(findElement(tree, "shot-2/car")).toBe(car2);
+  });
+
+  it("fails with not_found or not_a_group when a target or intermediate path segment is invalid", () => {
+    const rect = makeRect("flat-rect");
+    const tree: Element[] = [makeGroup("shot-1", [rect])];
+
+    expect(expectFailure(() => findElement(tree, "missing"))).toMatchObject({
+      code: "not_found",
+      path: "id",
+    });
+    expect(
+      expectFailure(() => findElement(tree, "shot-1/flat-rect/leaf")),
+    ).toMatchObject({
+      code: "not_a_group",
+      path: "id",
+    });
+  });
+
+  it("updates a nested element immutably while preserving untouched branches", () => {
+    const untouchedGroup = makeGroup("shot-2", [makeRect("s2-box", 5)]);
+    const tree: Element[] = [
+      makeGroup("shot-1", [makeRect("s1-car", 10)]),
+      untouchedGroup,
+    ];
+
+    const updated = updateElement(tree, "shot-1/s1-car", (el) => ({
+      ...el,
+      x: 99,
+    }));
+
+    expect((findElement(updated, "s1-car") as { x: number }).x).toBe(99);
+    expect((findElement(tree, "s1-car") as { x: number }).x).toBe(10);
+    expect(updated[1]).toBe(untouchedGroup);
+  });
+
+  it("reorders or filters siblings inside a nested group via updateSiblings", () => {
+    const a = makeRect("a");
+    const b = makeRect("b");
+    const tree: Element[] = [makeGroup("shot-1", [a, b])];
+
+    const reordered = updateSiblings(tree, "b", (siblings, i) => [
+      siblings[i] as Element,
+      ...siblings.filter((_, j) => j !== i),
+    ]);
+
+    const group = reordered[0] as GroupEl;
+    expect(group.children.map((c) => c.id)).toEqual(["b", "a"]);
+  });
+
+  it("inserts a child into a target group and rejects missing or non-group parents", () => {
+    const rect = makeRect("not-group");
+    const tree: Element[] = [makeGroup("shot-1", []), rect];
+    const added = makeRect("new-child");
+
+    const next = insertChild(tree, "shot-1", added);
+    expect((next[0] as GroupEl).children).toEqual([added]);
+
+    expect(
+      expectFailure(() => insertChild(tree, "missing", added)),
+    ).toMatchObject({
+      code: "not_found",
+      path: "parent",
+    });
+    expect(
+      expectFailure(() => insertChild(tree, "not-group", added)),
+    ).toMatchObject({
+      code: "not_a_group",
+      path: "parent",
+    });
+  });
+});
