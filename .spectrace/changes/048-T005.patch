+import type { Crop } from "../components/image/descriptor.ts";
+import { applyCrop } from "../engine/image-trim.ts";
+import type { ImageEl } from "../model/model.ts";
+
+/** A side of the crop: north, south, east, west. */
+export type CropEdge = "n" | "s" | "e" | "w";
+
+/** The smallest crop side, in canvas units. */
+const MIN = 16;
+
+const clamp = (v: number, lo: number, hi: number) =>
+  Math.min(hi, Math.max(lo, v));
+
+/**
+ * `el` with one crop side moved by `delta` canvas units (048/D6), towards east/south when
+ * positive. The side stays inside the picture and the crop keeps a minimum size; the picture
+ * keeps its scale, so it is never stretched.
+ */
+export function dragCropEdge(
+  el: ImageEl,
+  edge: CropEdge,
+  delta: number,
+): ImageEl {
+  const c = el.crop;
+  // fractions of the picture per canvas unit, along each axis
+  const fx = c.w / el.w;
+  const fy = c.h / el.h;
+  const right = c.x + c.w;
+  const bottom = c.y + c.h;
+  let crop: Crop;
+  if (edge === "e") {
+    const r = clamp(right + delta * fx, c.x + Math.min(MIN * fx, c.w), 1);
+    crop = { ...c, w: r - c.x };
+  } else if (edge === "w") {
+    const x = clamp(c.x + delta * fx, 0, right - Math.min(MIN * fx, c.w));
+    crop = { ...c, x, w: right - x };
+  } else if (edge === "s") {
+    const b = clamp(bottom + delta * fy, c.y + Math.min(MIN * fy, c.h), 1);
+    crop = { ...c, h: b - c.y };
+  } else {
+    const y = clamp(c.y + delta * fy, 0, bottom - Math.min(MIN * fy, c.h));
+    crop = { ...c, y, h: bottom - y };
+  }
+  return applyCrop(el, crop);
+}
