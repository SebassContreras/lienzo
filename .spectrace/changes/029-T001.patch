+import { describe, expect, it } from "vitest";
+import { computeAudioPlayback } from "./audio-timing.ts";
+
+describe("computeAudioPlayback", () => {
+  it("returns inactive if startOffset is beyond scene duration", () => {
+    const res = computeAudioPlayback({
+      t: 1,
+      sceneDuration: 5,
+      audioDuration: 10,
+      audio: { assetId: "a", startOffset: 6 },
+    });
+    expect(res).toEqual({ active: false });
+  });
+
+  it("returns inactive if trimOffset exceeds audioDuration", () => {
+    const res = computeAudioPlayback({
+      t: 1,
+      sceneDuration: 5,
+      audioDuration: 4,
+      audio: { assetId: "a", trimOffset: 5 },
+    });
+    expect(res).toEqual({ active: false });
+  });
+
+  it("schedules delayed start when t is before startOffset", () => {
+    const res = computeAudioPlayback({
+      t: 1,
+      sceneDuration: 6,
+      audioDuration: 10,
+      audio: { assetId: "a", startOffset: 2.5, trimOffset: 1 },
+    });
+    expect(res).toEqual({
+      active: true,
+      sourceOffset: 1,
+      delay: 1.5,
+      duration: 3.5, // min(6 - 2.5 = 3.5, 10 - 1 = 9)
+    });
+  });
+
+  it("computes correct sourceOffset and duration when t is in middle of audio", () => {
+    const res = computeAudioPlayback({
+      t: 3,
+      sceneDuration: 6,
+      audioDuration: 10,
+      audio: { assetId: "a", startOffset: 2, trimOffset: 1 },
+    });
+    expect(res).toEqual({
+      active: true,
+      sourceOffset: 2, // trimOffset (1) + (t - startOffset) (1)
+      delay: 0,
+      duration: 3, // maxPlayable (4) - 1
+    });
+  });
+
+  it("returns inactive when t is past audio end in scene", () => {
+    const res = computeAudioPlayback({
+      t: 4.5,
+      sceneDuration: 6,
+      audioDuration: 2, // 2s of audio starting at 1s ends at 3s
+      audio: { assetId: "a", startOffset: 1, trimOffset: 0 },
+    });
+    expect(res).toEqual({ active: false });
+  });
+});
diff --git a/src/engine/audio/audio-timing.ts b/src/engine/audio/audio-timing.ts
new file mode 100644
index 0000000..a9101be
--- /dev/null
+++ b/src/engine/audio/audio-timing.ts
@@ -0,0 +1,84 @@
+import type { SceneAudio } from "../../model/model.ts";
+
+export type AudioPlaybackState =
+  | {
+      active: false;
+    }
+  | {
+      active: true;
+      /** Offset in seconds into the source audio file to start playing from. */
+      sourceOffset: number;
+      /** Delay in seconds before playing if scene playhead hasn't reached audio startOffset yet. */
+      delay: number;
+      /** Duration in seconds to play before cutting off (or end of scene loop). */
+      duration: number;
+    };
+
+export type AudioTimingOptions = {
+  /** Scene playhead time t in seconds (0 <= t < sceneDuration). */
+  t: number;
+  /** Total scene loop duration in seconds. */
+  sceneDuration: number;
+  /** Scene audio configuration. */
+  audio: SceneAudio;
+  /** Total duration in seconds of the source audio asset. */
+  audioDuration: number;
+};
+
+/**
+ * Calculates what audio slice to play when the scene is at time `t`.
+ * High-cohesion pure function: no Web Audio dependencies, fully deterministic.
+ */
+export function computeAudioPlayback(
+  options: AudioTimingOptions,
+): AudioPlaybackState {
+  const { t, sceneDuration, audio, audioDuration } = options;
+  const startOffset = Math.max(0, audio.startOffset ?? 0);
+  const trimOffset = Math.max(0, audio.trimOffset ?? 0);
+
+  // If startOffset is beyond the scene loop duration, it never plays
+  if (startOffset >= sceneDuration) {
+    return { active: false };
+  }
+
+  // Audio available duration from trimOffset
+  const availableAudio = Math.max(0, audioDuration - trimOffset);
+  if (availableAudio <= 0) {
+    return { active: false };
+  }
+
+  // Maximum time audio can play in the scene loop: min(sceneDuration - startOffset, availableAudio)
+  const maxPlayableDuration = Math.min(
+    sceneDuration - startOffset,
+    availableAudio,
+  );
+  if (maxPlayableDuration <= 0) {
+    return { active: false };
+  }
+
+  const audioEndInScene = startOffset + maxPlayableDuration;
+
+  if (t < startOffset) {
+    // Playhead is before the audio starts: will start after delay (startOffset - t)
+    return {
+      active: true,
+      sourceOffset: trimOffset,
+      delay: startOffset - t,
+      duration: maxPlayableDuration,
+    };
+  }
+
+  if (t >= audioEndInScene) {
+    // Playhead is past when audio has finished in this loop cycle
+    return { active: false };
+  }
+
+  // Playhead is inside the active audio range
+  const elapsedSinceStart = t - startOffset;
+  return {
+    active: true,
+    sourceOffset: trimOffset + elapsedSinceStart,
+    delay: 0,
+    duration: maxPlayableDuration - elapsedSinceStart,
+  };
+}
