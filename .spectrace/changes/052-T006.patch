+      import("../../model/model.ts").Element,
+      { kind: "rect" }
+    >;
+
+    expect(rect.tracks?.x).toEqual({
+      keys: [
+        { t: 0, value: 0, easing: "linear" },
+        { t: 1, value: 100, easing: "auto" },
+      ],
+      repeat: "loop",
+      until: 4,
+    });
+    expect(rect.tracks?.y).toEqual({
+      keys: [
+        { t: 0, value: 10, easing: "step" },
+        { t: 2, value: 50, easing: "hold" },
