     elements.push(el);
   }
 
-  // Post-layout pass: resolve fit and anchors
-  for (const el of elements) {
-    const mutable = el as unknown as Record<string, unknown>;
-    if (mutable.__fit === "canvas") {
-      resolveFitCanvas(el, scene);
-      delete mutable.__fit;
-    }
-    if (mutable.__at) {
-      resolveAtPlacement(
