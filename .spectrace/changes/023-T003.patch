@@ -0,0 +1,293 @@
+/**
+ * Pure color math and WCAG 2.2 accessibility helpers (023/D3, R6, R11).
+ * Handles parsing, alpha compositing (Porter-Duff source-over),
+ * relative luminance, contrast ratio and OKLCH-based lightness adjustment.
+ */
+
+export type Rgba = [number, number, number, number];
+
+export interface OKLCH {
+  l: number; // 0 to 1
+  c: number; // >= 0
+  h: number; // 0 to 360
+}
+
+/**
+ * Parses a hex string (#rgb, #rgba, #rrggbb, #rrggbbaa) or rgb/rgba() string into [r, g, b, a]
+ * where r, g, b are in 0..255 and a is in 0..1.
+ */
+export function parseColor(color: string): Rgba {
+  const c = color.trim().toLowerCase();
+
+  if (c.startsWith("#")) {
+    const hex = c.slice(1);
+    if (hex.length === 3) {
+      const r = Number.parseInt(hex[0] + hex[0], 16);
+      const g = Number.parseInt(hex[1] + hex[1], 16);
+      const b = Number.parseInt(hex[2] + hex[2], 16);
+      return [r, g, b, 1];
+    }
+    if (hex.length === 4) {
+      const r = Number.parseInt(hex[0] + hex[0], 16);
+      const g = Number.parseInt(hex[1] + hex[1], 16);
+      const b = Number.parseInt(hex[2] + hex[2], 16);
+      const a = Number.parseInt(hex[3] + hex[3], 16) / 255;
+      return [r, g, b, a];
+    }
+    if (hex.length === 6) {
+      const r = Number.parseInt(hex.slice(0, 2), 16);
+      const g = Number.parseInt(hex.slice(2, 4), 16);
+      const b = Number.parseInt(hex.slice(4, 6), 16);
+      return [r, g, b, 1];
+    }
+    if (hex.length === 8) {
+      const r = Number.parseInt(hex.slice(0, 2), 16);
+      const g = Number.parseInt(hex.slice(2, 4), 16);
+      const b = Number.parseInt(hex.slice(4, 6), 16);
+      const a = Number.parseInt(hex.slice(6, 8), 16) / 255;
+      return [r, g, b, a];
+    }
+  }
+
+  const rgbMatch = c.match(
+    /^rgba?\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)(?:\s*,\s*([\d.]+))?\s*\)$/,
+  );
+  if (rgbMatch) {
+    const r = Number.parseInt(rgbMatch[1] ?? "0", 10);
+    const g = Number.parseInt(rgbMatch[2] ?? "0", 10);
+    const b = Number.parseInt(rgbMatch[3] ?? "0", 10);
+    const a = rgbMatch[4] !== undefined ? Number.parseFloat(rgbMatch[4]) : 1;
+    return [r, g, b, a];
+  }
+
+  // Fallback default black
+  return [0, 0, 0, 1];
+}
+
+/** Formats an [r, g, b] as #rrggbb */
+export function toHex(r: number, g: number, b: number): string {
+  const clamp = (v: number) =>
+    Math.max(0, Math.min(255, Math.round(v)))
+      .toString(16)
+      .padStart(2, "0");
+  return `#${clamp(r)}${clamp(g)}${clamp(b)}`;
+}
+
+/**
+ * Composites foreground `fg` over background `bg` using standard
+ * Porter-Duff source-over compositing.
+ */
+export function compositeRgba(fg: Rgba, bg: Rgba): Rgba {
+  const [r1, g1, b1, a1] = fg;
+  const [r2, g2, b2, a2] = bg;
+
+  const outA = a1 + a2 * (1 - a1);
+  if (outA <= 0) return [0, 0, 0, 0];
+
+  const outR = (r1 * a1 + r2 * a2 * (1 - a1)) / outA;
+  const outG = (g1 * a1 + g2 * a2 * (1 - a1)) / outA;
+  const outB = (b1 * a1 + b2 * a2 * (1 - a1)) / outA;
+
+  return [outR, outG, outB, outA];
+}
+
+/**
+ * Calculates WCAG 2.2 relative luminance for sRGB channels (0..255).
+ * Formula: https://www.w3.org/TR/WCAG22/#dfn-relative-luminance
+ */
+export function relativeLuminance(r: number, g: number, b: number): number {
+  const toLinear = (val: number) => {
+    const v = val / 255;
+    return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+  };
+  const rLin = toLinear(r);
+  const gLin = toLinear(g);
+  const bLin = toLinear(b);
+  return 0.2126 * rLin + 0.7152 * gLin + 0.0722 * bLin;
+}
+
+/**
+ * WCAG 2.2 contrast ratio between two relative luminance values.
+ * Ratio = (L1 + 0.05) / (L2 + 0.05) where L1 >= L2.
+ */
+export function contrastRatio(lum1: number, lum2: number): number {
+  const lighter = Math.max(lum1, lum2);
+  const darker = Math.min(lum1, lum2);
+  return (lighter + 0.05) / (darker + 0.05);
+}
+
+/**
+ * Converts sRGB [0..255] to OKLCH.
+ */
+export function rgbToOklch(r: number, g: number, b: number): OKLCH {
+  const toLinear = (val: number) => {
+    const v = val / 255;
+    return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4;
+  };
+
+  const rLin = toLinear(r);
+  const gLin = toLinear(g);
+  const bLin = toLinear(b);
+
+  const x =
+    0.41239079926595934 * rLin +
+    0.357584339383878 * gLin +
+    0.1804807884018343 * bLin;
+  const y =
+    0.21263900587151027 * rLin +
+    0.715168678767756 * gLin +
+    0.07219231536073371 * bLin;
+  const z =
+    0.01933081871559182 * rLin +
+    0.11919477979462598 * gLin +
+    0.9505321522496607 * bLin;
+
+  const lms_l =
+    0.819022437996703 * x + 0.3619062600528904 * y - 0.1288737815209879 * z;
+  const lms_m =
+    0.0329836539323885 * x + 0.9292868615863434 * y + 0.0361446663506424 * z;
+  const lms_s =
+    0.0481771893596242 * x + 0.2642395317527308 * y + 0.6335478284694309 * z;
+
+  const l_ = Math.cbrt(lms_l);
+  const m_ = Math.cbrt(lms_m);
+  const s_ = Math.cbrt(lms_s);
+
+  const L =
+    0.210454268309314 * l_ + 0.7936177747023054 * m_ - 0.0040720430116193 * s_;
+  const a =
+    1.9779985324311684 * l_ - 2.4285922420485799 * m_ + 0.450593709617411 * s_;
+  const b_lab =
+    0.0259040424655478 * l_ + 0.7827717124575296 * m_ - 0.8086757549230774 * s_;
+
+  const C = Math.hypot(a, b_lab);
+  let h = (Math.atan2(b_lab, a) * 180) / Math.PI;
+  if (h < 0) h += 360;
+
+  return { l: L, c: C, h: Number.isNaN(h) ? 0 : h };
+}
+
+/**
+ * Converts OKLCH to sRGB [0..255]. Clamped to [0, 255].
+ */
+export function oklchToRgb(oklch: OKLCH): [number, number, number] {
+  const hRad = (oklch.h * Math.PI) / 180;
+  const L = oklch.l;
+  const a = oklch.c * Math.cos(hRad);
+  const b_lab = oklch.c * Math.sin(hRad);
+
+  const l_ = L + 0.3963377773761749 * a + 0.2158037573099136 * b_lab;
+  const m_ = L - 0.1055613458156586 * a - 0.0638541728258133 * b_lab;
+  const s_ = L - 0.0894841775298119 * a - 1.2914855480194092 * b_lab;
+
+  const lms_l = l_ * l_ * l_;
+  const lms_m = m_ * m_ * m_;
+  const lms_s = s_ * s_ * s_;
+
+  const x =
+    1.2268798758459243 * lms_l -
+    0.5578149944602171 * lms_m +
+    0.2813910456659647 * lms_s;
+  const y =
+    -0.0405757452148008 * lms_l +
+    1.112286803280317 * lms_m -
+    0.0717110580655164 * lms_s;
+  const z =
+    -0.0763729366746601 * lms_l -
+    0.4214933324022432 * lms_m +
+    1.5869240198367816 * lms_s;
+
+  const rLin =
+    3.2409699419045226 * x - 1.537383177570094 * y - 0.4986107602930034 * z;
+  const gLin =
+    -0.9692436362808796 * x + 1.8759675015077202 * y + 0.04155505740717559 * z;
+  const bLin =
+    0.05563007969699366 * x - 0.20397695888897652 * y + 1.0569715142428786 * z;
+
+  const fromLinear = (val: number) => {
+    const clamped = Math.max(0, Math.min(1, val));
+    const v =
+      clamped <= 0.0031308
+        ? 12.92 * clamped
+        : 1.055 * clamped ** (1 / 2.4) - 0.055;
+    return Math.max(0, Math.min(255, Math.round(v * 255)));
+  };
+
+  return [fromLinear(rLin), fromLinear(gLin), fromLinear(bLin)];
+}
+
+/**
+ * Searches in OKLCH space for a suggested color keeping the original hue and chroma
+ * with adjusted lightness that satisfies the required contrast ratio against `bgRgb` (D3, R11).
+ */
+export function suggestAccessibleColor(
+  fgHex: string,
+  bgRgb: [number, number, number],
+  requiredRatio: number,
+): string {
+  const fgRgba = parseColor(fgHex);
+  const fgLum = relativeLuminance(fgRgba[0], fgRgba[1], fgRgba[2]);
+  const bgLum = relativeLuminance(bgRgb[0], bgRgb[1], bgRgb[2]);
+
+  if (contrastRatio(fgLum, bgLum) >= requiredRatio) {
+    return toHex(fgRgba[0], fgRgba[1], fgRgba[2]);
+  }
+
+  const oklch = rgbToOklch(fgRgba[0], fgRgba[1], fgRgba[2]);
+
+  // Determine direction: should we go lighter or darker?
+  // Check maximum possible contrasts at L=0 (black) and L=1 (white)
+  const blackLum = relativeLuminance(0, 0, 0);
+  const whiteLum = relativeLuminance(255, 255, 255);
+  const maxBlackRatio = contrastRatio(blackLum, bgLum);
+  const maxWhiteRatio = contrastRatio(whiteLum, bgLum);
+
+  // Prefer the direction closer to current fgLum or the one capable of meeting threshold
+  let targetLighter = fgLum >= bgLum;
+  if (
+    targetLighter &&
+    maxWhiteRatio < requiredRatio &&
+    maxBlackRatio >= requiredRatio
+  ) {
+    targetLighter = false;
+  } else if (
+    !targetLighter &&
+    maxBlackRatio < requiredRatio &&
+    maxWhiteRatio >= requiredRatio
+  ) {
+    targetLighter = true;
+  }
+
+  let low = targetLighter ? oklch.l : 0;
+  let high = targetLighter ? 1 : oklch.l;
+  let bestHex = targetLighter ? "#ffffff" : "#000000";
+
+  // Binary search for closest lightness that meets threshold
+  for (let i = 0; i < 20; i++) {
+    const mid = (low + high) / 2;
+    const candidateRgb = oklchToRgb({ l: mid, c: oklch.c, h: oklch.h });
+    const candidateLum = relativeLuminance(
+      candidateRgb[0],
+      candidateRgb[1],
+      candidateRgb[2],
+    );
+    const ratio = contrastRatio(candidateLum, bgLum);
+
+    if (ratio >= requiredRatio) {
+      bestHex = toHex(candidateRgb[0], candidateRgb[1], candidateRgb[2]);
+      if (targetLighter) {
+        high = mid; // Try to stay closer to original (lower L)
+      } else {
+        low = mid; // Try to stay closer to original (higher L)
+      }
+    } else {
+      if (targetLighter) {
+        low = mid;
+      } else {
+        high = mid;
+      }
+    }
+  }
+
+  return bestHex;
+}
