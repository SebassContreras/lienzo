diff --git a/src/presets/recipes.test.ts b/src/presets/recipes.test.ts
new file mode 100644
index 0000000..3e38c4e
--- /dev/null
+++ b/src/presets/recipes.test.ts
@@ -0,0 +1,28 @@
+import { describe, expect, it } from "vitest";
+import type { PresetRecipe } from "../model/preset.ts";
+import fixture from "./built-in.fixture.json";
+import { BUILT_IN_RECIPES } from "./recipes.ts";
+import { resolvePreset } from "./resolve.ts";
+
+/**
+ * `built-in.fixture.json` holds, in library order and without ids, the 13 elements the
+ * hand-written `built-in.ts` produced before the presets became recipes.
+ */
+describe("built-in recipes", () => {
+  it("are the 13 presets, in the same order", () => {
+    expect(BUILT_IN_RECIPES.map((r) => r.name)).toEqual(
+      fixture.map((el) => el.name),
+    );
+  });
+
+  it.each(BUILT_IN_RECIPES.map((r, i) => [r.name, i] as const))(
+    "«%s» resolves to the element it built before",
+    (_name, i) => {
+      const r = resolvePreset(BUILT_IN_RECIPES[i] as PresetRecipe);
+      if ("error" in r) throw new Error(r.error);
+      const { id, ...element } = r.element;
+      expect(typeof id).toBe("string");
+      expect(element).toEqual(fixture[i]);
+    },
+  );
+});
