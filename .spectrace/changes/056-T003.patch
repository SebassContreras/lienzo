 import type { DrawContext } from "../descriptor.ts";
 import type { UseEl } from "./descriptor.ts";
 
+/** Recursively clones element and applies overrides keyed by element id or path */
+export function instantiateSymbolElements(
+  elements: readonly Element[],
+  overrides?: Record<string, Record<string, unknown>>,
+  pathPrefix = "",
+): Element[] {
+  const result: Element[] = [];
+
+  for (let i = 0; i < elements.length; i++) {
+    const raw = elements[i];
+    const cloned = structuredClone(raw);
+    const idKey = cloned.id;
+    const indexKey = pathPrefix ? `${pathPrefix}.${i}` : `${i}`;
+
+    if (overrides) {
+      if (idKey && overrides[idKey]) {
+        deepMerge(cloned as unknown as Record<string, unknown>, overrides[idKey]);
+      }
+      if (overrides[indexKey]) {
+        deepMerge(cloned as unknown as Record<string, unknown>, overrides[indexKey]);
+      }
+    }
+
+    if (cloned.kind === "group" && Array.isArray((cloned as unknown as { children?: unknown }).children)) {
+      const groupEl = cloned as unknown as { children: Element[] };
+      groupEl.children = instantiateSymbolElements(
+        groupEl.children,
+        overrides,
+        indexKey,
+      );
+    }
+
+    result.push(cloned);
+  }
+
+  return result;
+}
+
+/** Draws an unmistakable diagnostic placeholder box when a symbol cannot be resolved */
+function drawMissingSymbolPlaceholder(ctx: Ctx, el: UseEl): void {
+  ctx.save();
+  ctx.strokeStyle = "#f59e0b";
+  ctx.lineWidth = 2;
+  ctx.setLineDash([6, 4]);
+  ctx.strokeRect(el.x, el.y, el.w, el.h);
+
+  ctx.fillStyle = "rgba(245, 158, 11, 0.1)";
+  ctx.fillRect(el.x, el.y, el.w, el.h);
+
+  ctx.fillStyle = "#f59e0b";
+  ctx.font = "bold 14px sans-serif";
+  ctx.textAlign = "center";
+  ctx.textBaseline = "middle";
+  const label = el.symbol ? `Symbol "${el.symbol}" not found` : "No symbol specified";
+  ctx.fillText(label, el.x + el.w / 2, el.y + el.h / 2);
+  ctx.restore();
+}
+
+/**
+ * Draws a `use` element by instantiating its referenced symbol, scaling its content
+ * to fit the instance box, and applying overrides.
+ */
 export function drawUse(
   ctx: Ctx,
   el: UseEl,
   st: AnimState,
-  drawContext: DrawContext,
+  { scene, t, drawElements }: DrawContext,
 ): void {
-  // stub to be fully implemented in T003
+  const symbol = scene.symbols ? scene.symbols[el.symbol] : undefined;
+  if (!symbol) {
+    drawMissingSymbolPlaceholder(ctx, el);
+    return;
+  }
+
+  const effectiveOpacity = typeof el.opacity === "number" ? el.opacity : 1;
+  const own = { ...st };
+  own.alpha *= effectiveOpacity;
+
+  const instanceBox = boxOf(el);
+  const targetW = el.w || 1;
+  const targetH = el.h || 1;
+  const sourceW = symbol.w || targetW;
+  const sourceH = symbol.h || targetH;
+  const scaleX = targetW / sourceW;
+  const scaleY = targetH / sourceH;
+
+  const instances = instantiateSymbolElements(symbol.children, el.overrides);
+
+  withTransform(ctx, instanceBox, own, () => {
+    ctx.translate(el.x, el.y);
+    ctx.scale(scaleX, scaleY);
+    drawElements(ctx, instances, scene, t);
+  });
 }
