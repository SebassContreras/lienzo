@@ -0,0 +1,79 @@
+import { describe, expect, it } from "vitest";
+import { defaultRect, defaultScene } from "../model/model.ts";
+import { drawScene } from "./render.ts";
+import { withEffects } from "./effects.ts";
+import { RecordingCtx, installCanvasFakes } from "../test/recording-ctx.ts";
+import type { Ctx } from "./paint.ts";
+
+installCanvasFakes();
+
+describe("effects field group and withEffects (025/T001, D1, D3)", () => {
+  it("does not save or restore ctx when blur is 0 and blend is normal", () => {
+    const ctx = new RecordingCtx();
+    withEffects(ctx as unknown as Ctx, { blur: 0, blend: "normal" }, () => {
+      ctx.fillRect(0, 0, 10, 10);
+    });
+    expect(ctx.log).toEqual(["fillRect(0,0,10,10)"]);
+  });
+
+  it("applies blur filter and restores ctx afterwards", () => {
+    const ctx = new RecordingCtx();
+    withEffects(ctx as unknown as Ctx, { blur: 15, blend: "normal" }, () => {
+      ctx.fillRect(0, 0, 10, 10);
+    });
+    expect(ctx.log).toEqual([
+      "save()",
+      "filter=(blur(15px))",
+      "fillRect(0,0,10,10)",
+      "restore()",
+    ]);
+  });
+
+  it("applies blend mode and restores ctx afterwards", () => {
+    const ctx = new RecordingCtx();
+    withEffects(ctx as unknown as Ctx, { blur: 0, blend: "multiply" }, () => {
+      ctx.fillRect(0, 0, 10, 10);
+    });
+    expect(ctx.log).toEqual([
+      "save()",
+      "globalCompositeOperation=(multiply)",
+      "fillRect(0,0,10,10)",
+      "restore()",
+    ]);
+  });
+
+  it("applies both blur and blend mode when specified", () => {
+    const ctx = new RecordingCtx();
+    withEffects(ctx as unknown as Ctx, { blur: 8, blend: "screen" }, () => {
+      ctx.fillRect(0, 0, 10, 10);
+    });
+    expect(ctx.log).toEqual([
+      "save()",
+      "globalCompositeOperation=(screen)",
+      "filter=(blur(8px))",
+      "fillRect(0,0,10,10)",
+      "restore()",
+    ]);
+  });
+
+  it("is applied by drawScene around element draw", () => {
+    const ctx = new RecordingCtx();
+    const scene = defaultScene();
+    const el = {
+      ...defaultRect(),
+      effects: { blur: 20, blend: "overlay" as const },
+    };
+    scene.elements = [el];
+    drawScene(ctx as unknown as Ctx, scene, 0);
+
+    const hasSave = ctx.log.includes("save()");
+    const hasFilter = ctx.log.includes("filter=(blur(20px))");
+    const hasBlend = ctx.log.includes("globalCompositeOperation=(overlay)");
+    const hasRestore = ctx.log.includes("restore()");
+
+    expect(hasSave).toBe(true);
+    expect(hasFilter).toBe(true);
+    expect(hasBlend).toBe(true);
+    expect(hasRestore).toBe(true);
+  });
+});
diff --git a/src/engine/effects.ts b/src/engine/effects.ts
new file mode 100644
index 0000000..4796202
--- /dev/null
+++ b/src/engine/effects.ts
@@ -0,0 +1,48 @@
+import type { BlendMode } from "../components/fields/effects.ts";
+import type { Ctx } from "./paint.ts";
+
+export type ElementEffects = {
+  blur?: number;
+  blend?: BlendMode;
+};
+
+/**
+ * Maps our BlendMode to Canvas 2D GlobalCompositeOperation.
+ * "normal" maps to "source-over".
+ */
+export function compositeOperationOf(mode: BlendMode | undefined): GlobalCompositeOperation {
+  if (!mode || mode === "normal") return "source-over";
+  return mode as GlobalCompositeOperation;
+}
+
+/**
+ * Wraps `draw` in the element's effects (025/D1): blur filter and blend mode.
+ * Uses Canvas 2D `save()` / `restore()` to prevent leaking effects to subsequent draws.
+ */
+export function withEffects(
+  ctx: Ctx,
+  fx: ElementEffects | undefined,
+  draw: () => void,
+): void {
+  const blur = fx?.blur ?? 0;
+  const blend = fx?.blend ?? "normal";
+
+  const hasBlur = blur > 0;
+  const hasBlend = blend !== "normal";
+
+  if (!hasBlur && !hasBlend) {
+    draw();
+    return;
+  }
+
+  ctx.save();
+  if (hasBlend) {
+    ctx.globalCompositeOperation = compositeOperationOf(blend);
+  }
+  if (hasBlur) {
+    // If ctx supports filter, set blur filter
+    ctx.filter = `blur(${blur}px)`;
+  }
+  draw();
+  ctx.restore();
+}
