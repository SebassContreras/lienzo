+import { describe, expect, it } from "vitest";
+import { createElement } from "../components/index.ts";
+import type { GroupEl, ImageEl, Scene } from "../model/model.ts";
+import { imageSources, withImageAspects } from "./image-aspect.ts";
+
+function image(src: string): ImageEl {
+  const el = createElement("image") as ImageEl;
+  el.src = src;
+  return el;
+}
+
+function sceneOf(...elements: Scene["elements"]): Scene {
+  return { width: 1920, height: 1080, elements } as Scene;
+}
+
+describe("withImageAspects", () => {
+  it("sets the real aspect and leaves the layout untouched", () => {
+    const el = image("/a.png");
+    const { x, y, w, h } = el;
+    const fixed = withImageAspects(sceneOf(el), new Map([["/a.png", 2]]));
+
+    const out = fixed.elements[0] as ImageEl;
+    expect(out.aspect).toBe(2);
+    expect({ x: out.x, y: out.y, w: out.w, h: out.h }).toEqual({ x, y, w, h });
+  });
+
+  it("fixes images inside groups", () => {
+    const group = createElement("group") as GroupEl;
+    group.children = [image("/b.png")];
+    const fixed = withImageAspects(sceneOf(group), new Map([["/b.png", 0.5]]));
+
+    const out = (fixed.elements[0] as GroupEl).children[0] as ImageEl;
+    expect(out.aspect).toBe(0.5);
+    expect(imageSources(fixed.elements)).toEqual(["/b.png"]);
+  });
+
+  it("returns the same scene when nothing changes", () => {
+    const scene = sceneOf(image("/c.png"));
+    expect(withImageAspects(scene, new Map())).toBe(scene);
+  });
+});
