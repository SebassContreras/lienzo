+/**
+ * Trimming and cropping an image element (048/D2, D3), pure so the editor and the MCP tools
+ * (049) share them.
+ */
+import type { Crop } from "../components/image/descriptor.ts";
+import type { ImageEl } from "../model/model.ts";
+
+/** Pixels at or below this alpha (0–255) count as empty: soft shadows, anti-aliasing. */
+const ALPHA_THRESHOLD = 8;
+
+/**
+ * The fractional rectangle holding every pixel whose alpha is above `threshold`, from RGBA
+ * bytes (`ImageData.data`); undefined when the picture has no such pixel.
+ */
+export function alphaBounds(
+  pixels: ArrayLike<number>,
+  width: number,
+  height: number,
+  threshold = ALPHA_THRESHOLD,
+): Crop | undefined {
+  let left = width;
+  let top = height;
+  let right = -1;
+  let bottom = -1;
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      if ((pixels[(y * width + x) * 4 + 3] ?? 0) <= threshold) continue;
+      if (x < left) left = x;
+      if (x > right) right = x;
+      if (y < top) top = y;
+      bottom = y;
+    }
+  }
+  if (right < 0) return undefined;
+  return {
+    x: left / width,
+    y: top / height,
+    w: (right - left + 1) / width,
+    h: (bottom - top + 1) / height,
+  };
+}
+
+/**
+ * `el` showing `crop` of its picture: the box moves and resizes so the pixels both crops
+ * show stay where they are on the canvas, and `aspect` becomes the cropped picture's.
+ */
+export function applyCrop(el: ImageEl, crop: Crop): ImageEl {
+  const old = el.crop;
+  // canvas units per fraction of the picture, along each axis
+  const sx = el.w / old.w;
+  const sy = el.h / old.h;
+  // the whole picture's width / height, from the shown part's
+  const natural = (el.aspect * old.h) / old.w;
+  return {
+    ...el,
+    crop,
+    x: el.x + (crop.x - old.x) * sx,
+    y: el.y + (crop.y - old.y) * sy,
+    w: crop.w * sx,
+    h: crop.h * sy,
+    aspect: (natural * crop.w) / crop.h,
+  };
+}
