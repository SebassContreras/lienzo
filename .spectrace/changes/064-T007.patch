@@ -0,0 +1,43 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { toolHarness } from "../../test/tool-harness.ts";
+
+let ok: Awaited<ReturnType<typeof toolHarness>>["ok"];
+
+beforeEach(async () => {
+  ({ ok } = await toolHarness());
+});
+
+const withUnknownField = {
+  elements: [{ kind: "rect", id: "card", glw: 3 }],
+  audioTracks: [],
+};
+
+describe("scene_build notices (064/R5)", () => {
+  it("names the saved scene in `saved`", async () => {
+    // Act
+    const res = await ok("scene_build", {
+      compact: withUnknownField,
+      save: "demo",
+    });
+
+    // Assert
+    expect(res.saved).toBe("demo");
+  });
+
+  it("lists every notice of a saving build once, in one list", async () => {
+    // Arrange
+    const compact = {
+      elements: [{ kind: "text", id: "title", font: "Montserrat", glw: 3 }],
+    };
+
+    // Act
+    const res = await ok("scene_build", { compact, save: "demo" });
+
+    // Assert
+    expect(res.notices).toEqual([
+      "Campo desconocido ignorado: compact.elements.0.glw",
+      expect.stringContaining("«Montserrat» no está instalada"),
+      expect.stringContaining("«Montserrat» es una estimación"),
+    ]);
+  });
+});
diff --git a/src/test/tool-harness.ts b/src/test/tool-harness.ts
new file mode 100644
index 0000000..cca315f
--- /dev/null
+++ b/src/test/tool-harness.ts
@@ -0,0 +1,28 @@
+/** A fresh project in a temp folder and a typed way to call its tools, for tool tests. */
+import { cp, mkdir, mkdtemp } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { type Ctx, createCtx } from "../service/ctx.ts";
+import { fakeRenderer } from "../service/fake-renderer.ts";
+import { registry } from "../service/tools/index.ts";
+
+export const PROJECT = "mi-proyecto";
+
+export async function toolHarness() {
+  const root = await mkdtemp(join(tmpdir(), "lienzo-tools-"));
+  await cp("presets/built-in", join(root, "presets", "built-in"), {
+    recursive: true,
+  });
+  await mkdir(join(root, "presets", "animations"), { recursive: true });
+  const ctx: Ctx = createCtx(root, fakeRenderer());
+  await registry.call("project_create", { slug: PROJECT, name: "P" }, ctx);
+
+  /** Calls tool `name` in the project and returns its value; throws on a tool error. */
+  async function ok(name: string, input: object) {
+    const r = await registry.call(name, { project: PROJECT, ...input }, ctx);
+    if (!r.ok) throw new Error(`${name}: ${JSON.stringify(r.error)}`);
+    return r.value as Record<string, unknown>;
+  }
+
+  return { ctx, ok };
+}
