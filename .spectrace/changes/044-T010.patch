+/** One subfolder of the folder being browsed, with the number of files anywhere under it. */
+export type AssetFolder = { name: string; path: string; count: number };
+
+export type AssetFolderView = { folders: AssetFolder[]; files: string[] };
+
+/**
+ * What the Recursos tab shows for `folder` (044/D6): its direct subfolders and its own files,
+ * from the flat relative paths of the inventory. `folder` is "" for the root of `assets/`.
+ */
+export function assetFolderView(
+  paths: readonly string[],
+  folder: string,
+): AssetFolderView {
+  const prefix = folder ? `${folder}/` : "";
+  const counts = new Map<string, number>();
+  const files: string[] = [];
+  for (const path of paths) {
+    if (!path.startsWith(prefix)) continue;
+    const rest = path.slice(prefix.length);
+    const slash = rest.indexOf("/");
+    if (slash === -1) files.push(path);
+    else {
+      const name = rest.slice(0, slash);
+      counts.set(name, (counts.get(name) ?? 0) + 1);
+    }
+  }
+  const folders = [...counts]
+    .map(([name, count]) => ({ name, path: `${prefix}${name}`, count }))
+    .sort((a, b) => a.name.localeCompare(b.name));
+  return { folders, files: files.sort() };
+}
+
+/** The file name of a relative asset path (`brand/logo.png` → `logo.png`). */
+export const assetFileName = (path: string) => path.slice(path.lastIndexOf("/") + 1);
