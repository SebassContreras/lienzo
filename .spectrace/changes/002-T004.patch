+/**
+ * Copies of `ids`, shifted by 30 px. A copied line attached to another copied element is
+ * attached to that element's copy; other attached ends stay where they are drawn.
+ */
+function duplicateElements(scene: Scene, ids: string[]): Element[] {
+  const originals = scene.elements.filter((el) => ids.includes(el.id));
+  const newIds = new Map(originals.map((el) => [el.id, cloneElement(el).id]));
+  const byId = indexById(scene);
+  const moving = new Set(newIds.keys());
+  return originals.map((el) => {
+    const moved = translate(el, 30, 30, byId, moving);
+    const copy = { ...structuredClone(moved), id: newIds.get(el.id) as string };
+    if (copy.kind === "line") {
+      for (const end of [copy.a, copy.b]) {
+        if (end.attach) end.attach = newIds.get(end.attach) ?? end.attach;
+      }
+    }
+    return copy;
+  });
+}
