diff --git a/src/service/tools/preset-delete.ts b/src/service/tools/preset-delete.ts
new file mode 100644
index 0000000..06c195f
--- /dev/null
+++ b/src/service/tools/preset-delete.ts
@@ -0,0 +1,17 @@
+import { z } from "zod";
+import { removeIn } from "../project-files.ts";
+import { inProject, PROJECT } from "../project-scope.ts";
+import { defineTool } from "../registry.ts";
+
+export const presetDelete = defineTool({
+  name: "preset_delete",
+  description:
+    "Delete a preset from the project's presets/ by file name. Built-in presets are not in " +
+    "the project and cannot be deleted.",
+  input: z.object({ project: PROJECT, name: z.string().min(1) }),
+  output: z.object({ ok: z.literal(true) }),
+  async run({ project, name }, ctx) {
+    await removeIn(await inProject(ctx, project), "presets", name);
+    return { ok: true as const };
+  },
+});
diff --git a/src/service/tools/preset-rename.ts b/src/service/tools/preset-rename.ts
new file mode 100644
index 0000000..d9ac242
--- /dev/null
+++ b/src/service/tools/preset-rename.ts
@@ -0,0 +1,20 @@
+import { z } from "zod";
+import { renameIn } from "../project-files.ts";
+import { inProject, PROJECT } from "../project-scope.ts";
+import { defineTool } from "../registry.ts";
+
+export const presetRename = defineTool({
+  name: "preset_rename",
+  description:
+    "Rename a preset in the project's presets/ (its file and its stored name). Built-in " +
+    "presets are not in the project and cannot be renamed. Fails when `to` is taken.",
+  input: z.object({
+    project: PROJECT,
+    from: z.string().min(1),
+    to: z.string().min(1),
+  }),
+  output: z.object({ preset: z.string() }),
+  run: async ({ project, from, to }, ctx) => ({
+    preset: await renameIn(await inProject(ctx, project), "presets", from, to),
+  }),
+});
diff --git a/src/service/tools/preset-save.ts b/src/service/tools/preset-save.ts
new file mode 100644
index 0000000..455091a
--- /dev/null
+++ b/src/service/tools/preset-save.ts
@@ -0,0 +1,31 @@
+import { z } from "zod";
+import { parsePresetRecipe } from "../../model/schema.ts";
+import { readJson, writeJson } from "../../presets/json-fs.ts";
+import { slugify } from "../../presets/slug.ts";
+import { folderOf } from "../project-files.ts";
+import { inProject, PROJECT } from "../project-scope.ts";
+import { defineTool, fail } from "../registry.ts";
+
+export const presetSave = defineTool({
+  name: "preset_save",
+  description:
+    "Save a preset recipe (checked as preset_validate checks it) into the project's presets/, " +
+    'as the editor\'s "Guardar como preset" does. The file is named after `file`, else the ' +
+    "recipe's name; fails when it exists unless `overwrite` is true.",
+  input: z.object({
+    project: PROJECT,
+    recipe: z.unknown(),
+    file: z.string().min(1).optional(),
+    overwrite: z.boolean().optional(),
+  }),
+  output: z.object({ preset: z.string() }),
+  async run({ project, recipe, file, overwrite }, ctx) {
+    const parsed = parsePresetRecipe(recipe);
+    if (!parsed.ok) fail("invalid_preset", parsed.error, parsed.path);
+    const dir = folderOf(await inProject(ctx, project), "presets");
+    const name = file ?? parsed.value.name;
+    if (!overwrite && (await readJson(dir, name)) !== undefined)
+      fail("exists", `Ya existe el preset «${slugify(name)}»`, "file");
+    return { preset: await writeJson(dir, name, parsed.value) };
+  },
+});
