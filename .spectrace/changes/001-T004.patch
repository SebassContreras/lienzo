+:root {
+  --bg: #0b0d12;
+  --panel: #12151c;
+  --panel-2: #181c25;
+  --line: #242a36;
+  --text: #e5e7eb;
+  --muted: #8b93a3;
+  --accent: #38bdf8;
+  font-family: "Inter", system-ui, sans-serif;
+  font-size: 13px;
+  color: var(--text);
+  color-scheme: dark;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html,
+body,
+#root {
+  margin: 0;
+  height: 100%;
+  background: var(--bg);
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+
+button {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  background: var(--panel-2);
+  border: 1px solid var(--line);
+  border-radius: 6px;
+  padding: 5px 9px;
+  cursor: pointer;
+}
+button:hover:not(:disabled) {
+  border-color: #3a4252;
+}
+button:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+button.primary {
+  background: #0369a1;
+  border-color: #0284c7;
+}
+
+input,
+select,
+textarea {
+  background: var(--bg);
+  border: 1px solid var(--line);
+  border-radius: 5px;
+  padding: 4px 6px;
+}
+
+.app {
+  display: grid;
+  grid-template-columns: 270px 1fr 300px;
+  grid-template-rows: 48px 1fr;
+  height: 100%;
+}
+
+.topbar {
+  grid-column: 1 / -1;
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 0 12px;
+  border-bottom: 1px solid var(--line);
+  background: var(--panel);
+}
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-weight: 700;
+}
+.brand span {
+  color: var(--muted);
+  font-weight: 400;
+}
+.group {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+.scene-name {
+  width: 140px;
+}
+.open {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+.status {
+  flex: 1;
+  color: var(--muted);
+  text-align: right;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.library,
+.panel {
+  background: var(--panel);
+  overflow-y: auto;
+}
+.library {
+  border-right: 1px solid var(--line);
+  padding: 10px;
+}
+.library h3 {
+  margin: 12px 2px 8px;
+  font-size: 11px;
+  text-transform: uppercase;
+  letter-spacing: 0.06em;
+  color: var(--muted);
+}
+.library .basics {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 6px;
+}
+.library .basics .item {
+  flex-direction: column;
+  padding: 10px 4px;
+  font-size: 12px;
+}
+.library .grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 6px;
+}
+.library .grid .item {
+  flex-direction: column;
+  padding: 4px;
+  gap: 4px;
+  font-size: 11px;
+  cursor: grab;
+}
+.library .grid canvas {
+  border-radius: 4px;
+  display: block;
+  max-width: 100%;
+}
+
+.center {
+  display: grid;
+  grid-template-rows: 1fr 44px;
