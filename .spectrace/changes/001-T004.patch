+}
+.inspector-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 10px;
+  border-bottom: 1px solid var(--line);
+  position: sticky;
+  top: 0;
+  background: var(--panel);
+  z-index: 1;
+}
+.inspector-head .name {
+  flex: 1;
+  min-width: 0;
+  font-weight: 600;
+}
+.icon-row {
+  display: flex;
+  gap: 4px;
+}
+.icon-row button {
+  padding: 4px 6px;
+}
+
+.section {
+  border-bottom: 1px solid var(--line);
+}
+.section summary {
+  cursor: pointer;
+  padding: 8px 10px;
+  font-weight: 600;
+  user-select: none;
+}
+.section-body {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 0 10px 10px;
+}
+
+.field {
+  display: grid;
+  grid-template-columns: 84px 1fr 58px;
+  align-items: center;
+  gap: 6px;
+}
+.field > span {
+  color: var(--muted);
+  font-size: 12px;
+}
+.field select {
+  grid-column: 2 / 4;
+}
+.field input[type="range"] {
+  width: 100%;
+}
+.field .num,
+.field .hex {
+  width: 100%;
+  padding: 3px 4px;
+}
+.field input[type="color"] {
+  width: 100%;
+  height: 26px;
+  padding: 1px;
+}
+.field.check input {
+  justify-self: start;
+}
+.field.column {
+  grid-template-columns: 1fr;
+}
+.field textarea {
+  resize: vertical;
+}
+
+.attached {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 6px;
+  font-size: 12px;
+}
+.attached b {
+  color: #4ade80;
+}
+.hint {
+  color: var(--muted);
+  font-size: 12px;
+  line-height: 1.4;
+}
+.hint.pad {
+  padding: 10px;
+}
+.preset-save {
+  display: flex;
+  gap: 6px;
+}
+.preset-save input {
+  flex: 1;
+  min-width: 0;
+}
+code {
+  font-family: "JetBrains Mono", monospace;
+  font-size: 11px;
+}
