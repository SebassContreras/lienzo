  {
    "id": "F04-group-child-element-update-at-box",
    "source": "spec 092 / 2026-11-02 QA finding F-04",
    "setup": [
      {
        "tool": "scene_build",
        "input": {
          "compact": {
            "duration": 4,
            "width": 1000,
            "height": 800,
            "elements": [
              {
                "id": "g",
                "kind": "group",
                "x": 100,
                "y": 100,
                "w": 400,
                "h": 300,
                "cw": 400,
                "ch": 300,
                "children": [
                  {
                    "id": "child",
                    "kind": "rect",
                    "w": 50,
                    "h": 50,
                    "at": "center"
                  }
                ]
              }
            ]
          },
          "save": "repro-group-at",
          "overwrite": true
        }
      }
    ],
    "call": {
      "tool": "element_update",
      "input": {
        "scene": "repro-group-at",
        "id": "g/child",
        "at": "center",
        "patch": {}
      }
    },
    "expect": { "ok": true }
  },
  {
    "id": "F05-compact-inline-error-parity",
    "source": "spec 093 / 2026-11-02 QA finding F-05",
    "call": {
      "tool": "scene_validate",
      "input": {
        "compact": {
          "duration": 601,
          "fps": 61,
          "elements": [{ "id": "bad-el", "kind": "unknown_kind_xyz" }]
        }
      }
    },
    "expect": {
      "ok": true,
      "value": {
        "valid": false,
        "errors": [
          { "path": "compact.duration" },
          { "path": "compact.fps" },
          { "path": "compact.elements.bad-el.kind" }
        ]
      }
    }
  },
  {
