[
  {
    "id": "D1-scene-create-ignored-at",
    "source": "live run 2026-10-29 (third), finding 3",
    "call": {
      "tool": "scene_create",
      "input": {
        "scene": "t",
        "data": {
          "elements": [{ "id": "c", "kind": "ellipse", "at": "center" }]
        }
      }
    },
    "expect": {
      "ok": true,
      "notices": ["Campo desconocido ignorado: elements\\.c\\.at"]
    }
  },
  {
    "id": "D2-at-track-notice-names-the-id",
    "source": "live run 2026-10-29 (third), warnings 1",
    "call": {
      "tool": "scene_build",
      "input": {
        "compact": {
          "elements": [
            { "kind": "rect", "id": "a" },
            {
              "kind": "ellipse",
              "id": "circle",
              "at": "center",
              "tracks": { "x": [[0, 10], [1, 50]] }
            }
          ]
        }
      }
    },
    "expect": {
      "ok": true,
      "notices": ["compact\\.elements\\.circle: tiene `at` y una pista"],
      "noNotices": ["elements\\.1:"]
    }
  },
  {
    "id": "D3-weight-notice-names-the-element",
    "source": "live run 2026-10-29 (third), warnings 3",
    "call": {
      "tool": "element_add",
      "input": {
        "scene": "s",
        "kind": "text",
        "patch": { "id": "t1", "weight": 500, "text": "hola" }
      }
    },
    "expect": { "ok": true, "notices": ["peso 500.*«t1»"] }
  },
  {
    "id": "D4-keyframe-set-repeats-no-easing-notice",
    "source": "live run 2026-10-29 (third), warnings 4",
    "setup": [
      {
        "tool": "element_add",
        "input": { "scene": "s", "kind": "rect", "patch": { "id": "r" } }
      },
      {
        "tool": "keyframe_set",
        "input": {
          "scene": "s",
          "id": "r",
          "path": "@rotate",
          "t": 0,
          "value": 0
        }
      },
      {
        "tool": "keyframe_set",
        "input": {
          "scene": "s",
          "id": "r",
          "path": "@rotate",
          "t": 1,
          "value": 90,
          "easing": "ease-out"
        }
      }
    ],
    "call": {
      "tool": "keyframe_set",
      "input": {
        "scene": "s",
        "id": "r",
        "path": "opacity",
        "t": 0,
        "value": 0.5
      }
    },
    "expect": { "ok": true, "noNotices": ["último keyframe"] }
  },
  {
    "id": "D5-element-update-repeats-no-weight-notice",
    "source": "live run 2026-10-29 (third), warnings 3",
    "setup": [
      {
        "tool": "element_add",
        "input": {
          "scene": "s",
          "kind": "text",
          "patch": { "id": "t1", "weight": 500, "text": "hola" }
        }
      }
    ],
    "call": {
      "tool": "element_update",
      "input": { "scene": "s", "id": "t1", "patch": { "opacity": 0.5 } }
    },
    "expect": { "ok": true, "noNotices": ["peso 500"] }
  },
  {
    "id": "F03-group-child-counter-shot-start",
    "source": "spec 092 / 2026-11-02 QA finding F-03",
    "call": {
      "tool": "scene_build",
      "input": {
        "compact": {
          "duration": 8,
          "shots": [
            { "id": "s1", "start": 0, "end": 4 },
            { "id": "s2", "start": 4, "end": 8 }
          ],
          "elements": [
            {
              "id": "g2",
              "kind": "group",
              "shot": "s2",
              "children": [{ "id": "cnt", "kind": "counter" }]
            }
          ]
        }
      }
    },
    "expect": { "ok": true }
  },
  {
    "id": "F04-group-child-element-update-at-box",
    "source": "spec 092 / 2026-11-02 QA finding F-04",
    "setup": [
      {
        "tool": "scene_build",
        "input": {
          "compact": {
            "duration": 4,
            "width": 1000,
            "height": 800,
            "elements": [
              {
                "id": "g",
                "kind": "group",
                "x": 100,
                "y": 100,
                "w": 400,
                "h": 300,
                "cw": 400,
                "ch": 300,
                "children": [
                  {
                    "id": "child",
                    "kind": "rect",
                    "w": 50,
                    "h": 50,
                    "at": "center"
                  }
                ]
              }
            ]
          },
          "save": "repro-group-at",
          "overwrite": true
        }
      }
    ],
    "call": {
      "tool": "element_update",
      "input": {
        "scene": "repro-group-at",
        "id": "g/child",
        "at": "center",
        "patch": {}
      }
    },
    "expect": { "ok": true }
  }
]
