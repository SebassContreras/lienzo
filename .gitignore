# Dependencies
node_modules/

# Build output
dist/
coverage/

# Local env
.env*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.muxel/

# User project workspaces (mi-proyecto is the default committed template)
projects/*
!projects/.gitkeep
!projects/mi-proyecto/
!projects/mi-proyecto/**

# User fonts (045): global fonts/ and every project's fonts/, never committed
fonts/*
!fonts/.gitkeep
projects/mi-proyecto/fonts/

# coverage and mutation reports (082)
reports/
.stryker-tmp/
