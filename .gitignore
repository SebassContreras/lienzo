# Dependencies
node_modules/

# Build output
dist/
coverage/

# Local env
.env*
!.env.example

# Python caches (the spectrace trace)
__pycache__/

# spectrace open task
.spectrace/state.json

# OS / editor
.DS_Store
Thumbs.db
.muxel/

# User project workspaces (mi-proyecto is the default committed template)
projects/*
!projects/.gitkeep
!projects/mi-proyecto/
!projects/mi-proyecto/**

# User fonts (045): global fonts/ and every project's fonts/, never committed
fonts/*
!fonts/.gitkeep
projects/mi-proyecto/fonts/
